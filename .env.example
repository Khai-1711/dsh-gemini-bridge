# =============================================
# DSH Gemini Bridge - Environment Configuration
# =============================================
# Copy file này thành .env (hoặc .env.acc1, .env.acc2) rồi điền giá trị thật vào.

# [BẮT BUỘC] Cookie Gemini Web — Lấy từ trình duyệt (F12 → Application → Cookies → gemini.google.com)
SECURE_1PSID=your_1psid_cookie_here
SECURE_1PSIDTS=your_1psidts_cookie_here

# [TÙY CHỌN] Cookie dự phòng (Failover Pool) — Dùng tài khoản Google thứ 2..5
BACKUP_1PSID=
BACKUP_1PSIDTS=
BACKUP_1_LABEL=backup1
BACKUP_2PSID=
BACKUP_2PSIDTS=
BACKUP_2_LABEL=backup2
BACKUP_3PSID=
BACKUP_3PSIDTS=
BACKUP_3_LABEL=backup3
BACKUP_4PSID=
BACKUP_4PSIDTS=
BACKUP_4_LABEL=backup4

# [TÙY CHỌN] Chế độ Khách (chỉ dùng khi KHÔNG cấu hình cookie) & Quota Cooldown / Handoff
ALLOW_GUEST_MODE=true
QUOTA_COOLDOWN_HOURS=24
AUTH_COOLDOWN_MINUTES=60
HANDOFF_ENABLE=true
HANDOFF_MAX_CHARS=2500
HANDOFF_SOURCE_MAX_CHARS=12000
HANDOFF_RECENT_TURNS=2
REPLAY_MAX_CHARS=8000
HANDOFF_FLASH_TIMEOUT=60
BRIDGE_DEBUG_FAKE_QUOTA=false

# [TÙY CHỌN] Model do người dùng tự chọn (để trống = dùng lựa chọn trên Dashboard hoặc mặc định tài khoản)
DEFAULT_MODEL=
# Model dự phòng khi timeout/lỗi (để trống = KHÔNG tự ý đổi model sau lưng người dùng)
FALLBACK_MODEL=
# Tự sửa nội bộ 1 vòng khi Gemini trả tool call lỗi cú pháp hoặc phản hồi trống
TOOL_PARSE_SELF_CORRECTION=true
EMPTY_REPLY_RETRIES=1

# [TÙY CHỌN] API Key bảo vệ endpoint (để trống = tắt xác thực trên loopback)
API_KEY=

# [TÙY CHỌN] Server
# HOST=127.0.0.1 là mặc định AN TOÀN. Chỉ đặt 0.0.0.0 khi cần dùng từ máy khác VÀ đã đặt API_KEY.
HOST=127.0.0.1
PORT=10000

# [TÙY CHỌN] An toàn mạng LAN & Tên miền
# ALLOW_INSECURE_LAN=false    # (nguy hiểm) cho phép mở ra mạng (0.0.0.0) mà không có API_KEY
# ALLOWED_HOSTS=pc2.lan       # tên host bổ sung được phép ngoài loopback và IP LAN (phân cách bằng dấu phẩy)
# LANE_ADMIN_TOKEN=           # token bí mật xác thực điều khiển giữa gateway và các luồng worker

# [TÙY CHỌN] Trạng thái lúc khởi động: on = tự bật lúc chạy; off = chờ bấm BẬT trên dashboard
API_START_STATE=on
# Số giây tối đa chờ request đang chạy xong khi bấm TẮT
DISABLE_DRAIN_TIMEOUT=120

# [TÙY CHỌN] Timeout Stream & Fallback (giây — rộng rãi cho model thinking & gọi tool nhiều bước)
# Giới hạn chờ phản hồi đầu tiên (mặc định 180s = 3 phút)
GEMINI_HARD_TIMEOUT=180
# Chờ chunk đầu tiên (thoughts_delta hoặc text_delta) trước khi soft-fallback tạm thời (chỉ chạy khi đặt FALLBACK_MODEL)
MODEL_FIRST_BYTE_FALLBACK_TIMEOUT=90
# Idle timeout tối đa giữa hai chunk liên tiếp khi model đã bắt đầu suy nghĩ/stream (mặc định 120s = 2 phút)
GEMINI_CHUNK_IDLE_TIMEOUT=120
# Trần tổng thời gian cho cả lượt stream (mặc định 420s = 7 phút để model hoàn thành code đầy đủ)
GEMINI_STREAM_OVERALL_TIMEOUT=420
# Giãn cách tối thiểu giữa 2 request liên tiếp
MIN_REQUEST_INTERVAL=0.5
# Deadline tổng cho request kèm ảnh upload trực tiếp (tối đa 120s)
IMAGE_REQUEST_TIMEOUT=90

# [TÙY CHỌN] Nhãn dễ đọc của instance này (hiện trên /health và dashboard)
# INSTANCE_LABEL="Frontend"
# Chạy nhiều luồng song song qua Frontend Gateway (Port 10000 -> acc1:10001, acc2:10002):
# --- .env (Gateway Port 10000) ---
# PORT="10000"
# INSTANCE_LABEL="Frontend"
# PEER_LANES="acc1=http://127.0.0.1:10001,acc2=http://127.0.0.1:10002"
# LANE_ADMIN_TOKEN="<chuỗi ngẫu nhiên DÀI dùng chung>"
#
# --- .env.acc1 (Worker 1 Port 10001) ---
# PORT="10001"
# INSTANCE_LABEL="Agent-1"
# PEER_LANES="acc2=http://127.0.0.1:10002"
# LANE_ADMIN_TOKEN="<cùng chuỗi như .env>"
#
# --- .env.acc2 (Worker 2 Port 10002) ---
# PORT="10002"
# INSTANCE_LABEL="Agent-2"
# PEER_LANES="acc1=http://127.0.0.1:10001"
# LANE_ADMIN_TOKEN="<cùng chuỗi như .env>"
# Tạo token an toàn:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# [TÙY CHỌN] Phạm vi thư mục làm việc (mở tự do theo IDE/đoạn chat)
# WORKSPACE_SANDBOX_MODE=client     # client = mở tự do theo thư mục đang mở trên IDE (chỉ chặn lệnh phá OS cực đoan)
#                                   # workspace = khóa mềm trong thư mục dự án nhận diện từ đoạn chat / DEFAULT_PROJECT_DIR
# DEFAULT_PROJECT_DIR=              # để trống = không khóa vào thư mục/ổ cố định nào
WORKSPACE_SANDBOX_MODE=client
DEFAULT_PROJECT_DIR=
# GATEWAY_MODE=auto                 # auto | on | off (mặc định bật Gateway khi có PEER_LANES và không có BRIDGE_INSTANCE)

# [TÙY CHỌN] Giới hạn ảnh mỗi lượt (mặc định: 4)
MAX_IMAGES_PER_TURN=4

# [TÙY CHỌN] Giới hạn ký tự tool result (mỗi kết quả 12000; tổng nhiều tool song song trong 1 lượt tối đa 36000)
MAX_TOOL_RESULT_CHARS=12000
MAX_TOTAL_TOOL_RESULTS_CHARS=36000

# [TÙY CHỌN] Timeout chờ hàng đợi Lock (giây, mặc định: 30)
LOCK_ACQUIRE_TIMEOUT=30

# [TÙY CHỌN] Thư mục lưu cookie đã xoay của gemini-webapi (mặc định: .gemini_cookies/)
# GEMINI_COOKIE_PATH=D:\GG_API_TEST\gemini\dsh_gemini_bridge\.gemini_cookies

# [TÙY CHỌN] Profile Vault & Auto Cookie Sync (đăng nhập 1 lần, tự nạp ngầm không cần mở tab)
# AUTO_COOKIE_SYNC=true             # tự động sync ngầm khi worker báo UNAUTHENTICATED nếu profile đã có trong kho
# COOKIE_SYNC_BROWSER=auto          # auto | chrome | edge | đường dẫn .exe trình duyệt
# COOKIE_PROFILES_DIR=              # mặc định .cookie_profiles/ (tách biệt hoàn toàn Chrome cá nhân)
# COOKIE_SYNC_TIMEOUT=25            # thời gian chờ tối đa 1 phiên sync ngầm (giây)
# COOKIE_SYNC_COOLDOWN=120          # giãn cách tối thiểu giữa 2 lần auto-sync cùng profile (giây)
